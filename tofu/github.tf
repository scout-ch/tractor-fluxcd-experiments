  source = "git::ssh://git@github.com/scout-ch/tractor-k8s-tenants.git//tofu/modules/gateway_api_crds?ref=a2cd7d68e08bb0e9445b746e76e3fcd8098cb42d" # main

  github_repository = module.flux.config_repository
}

